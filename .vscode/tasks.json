{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc.exe build with Raylib",
            "command": "C:\\MinGW\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}/main_gui.c",
                "${workspaceFolder}/src/engine.c",
                "${workspaceFolder}/src/mnist.c",
                "-I${workspaceFolder}/include",
                "-I${workspaceFolder}/raylib/include",
                "-L${workspaceFolder}/raylib/lib",
                "-o",
                "${workspaceFolder}/tasks.exe",
                "-lraylib",
                "-lgdi32",
                "-lwinmm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Raylib ve AI Motoru derleme görevi."
        }
    ]
}